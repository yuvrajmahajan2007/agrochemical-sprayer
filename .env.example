# ============================================================
# AI-Driven Precision Agrochemical Sprayer - Environment config
# ============================================================
# Copy this file to `.env` (optional) and adjust values, OR set these
# as real environment variables in your shell / service.
#
# This project has NO hard-coded secrets. Every tunable is an
# environment variable with a sensible default, listed here so you
# can override them per deployment.

# ---------- Server / network ----------
# Host to bind. 0.0.0.0 = reachable from phones/ESP32-CAM on the same Wi-Fi.
SPRAYBOT_HOST=0.0.0.0
SPRAYBOT_PORT=5000

# CORS: comma-separated allowed origins. Default "*" (any) for LAN demo.
# Example: SPRAYBOT_CORS_ORIGINS=http://192.168.1.10:5000,http://192.168.1.20:5000
SPRAYBOT_CORS_ORIGINS=*

# Optional: force the base URL the mobile frontend uses (e.g. ngrok/cloud URL).
# If empty, the backend auto-uses the request host (LAN IP) it is served from.
# SPRAYBOT_API_BASE_URL=http://192.168.1.105:5000

# ---------- Confidence gating (Stage 1) ----------
# Plant / leaf validation minimum confidence (%). Below it -> Low Plant Confidence.
SPRAYBOT_PLANT_THRESHOLD=70.0

# ---------- Severity thresholds (health segmentation) ----------
# Affected-area % maps to severity:
#   0% -> Healthy;  (0, LOW] -> Low;  (LOW, MED] -> Medium;  > MED -> High
SPRAYBOT_SEVERITY_LOW=10.0
SPRAYBOT_SEVERITY_MED=40.0

# ---------- Leaf-health segmentation ----------
# U-Net input resolution (pixels).
SPRAYBOT_SEG_IMG_SIZE=128

# ---------- Legacy classifier thresholds (not used by the new pipeline) ----------
# SPRAYBOT_IDENTIFIER_THRESHOLD=70.0
# SPRAYBOT_DISEASE_THRESHOLD=60.0
# SPRAYBOT_TEMPERATURE=2.0
# SPRAYBOT_GREEN_MIN=0.05
# SPRAYBOT_TEXTURE_MIN=1.5
